<UserControl x:Class="Eshop.Operations.Desktop.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Width="120"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding LoadPaymentsCommand}"
                        Content="Refresh payments" />
                <Button Width="80"
                        Margin="8,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding LoadPaymentsCancelCommand}"
                        Content="Cancel" />
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="{Binding StatusText}" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Text="Search" />
                    <TextBox MinWidth="180"
                             Style="{StaticResource FilterTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Text="Status" />
                    <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Text="Sort by" />
                    <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>
                <Button Grid.Column="3"
                        MinWidth="80"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ResetViewCommand}"
                        Content="Reset" />
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Style="{StaticResource ErrorPanelBorderStyle}"
                Visibility="{Binding HasError,
                             Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Style="{StaticResource ErrorTitleTextStyle}"
                           Text="Payments request failed" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Refresh Payments to load operational data."
                           Visibility="{Binding IsInitialState,
                               Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="No payments were returned."
                           Visibility="{Binding IsEmpty,
                               Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="No payments match the current filters."
                           Visibility="{Binding IsFilteredEmpty,
                               Converter={StaticResource BooleanToVisibilityConverter}}" />

                <DataGrid x:Name="PaymentsDataGrid"
                          ItemsSource="{Binding PaymentsView}"
                          Visibility="{Binding HasVisiblePayments,
                              Converter={StaticResource BooleanToVisibilityConverter}}"
                          CurrentCellChanged="PaymentsDataGrid_CurrentCellChanged"
                          Style="{StaticResource OperationalDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="*" />
                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding Amount,
                                                      StringFormat={}{0:N2}}"
                                            Width="*" />
                        <DataGridTextColumn Header="Currency"
                                            Binding="{Binding Currency}"
                                            Width="80" />
                        <DataGridTextColumn Header="Method"
                                            Binding="{Binding PaymentMethod}"
                                            Width="*" />
                        <DataGridTextColumn Header="Order ID"
                                            Binding="{Binding OrderId}"
                                            Width="2*" />
                        <DataGridTextColumn Header="Created"
                                            Binding="{Binding CreatedAtUtc,
                                                      StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" />

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Select a payment to view details.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPayment}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ContentControl Content="{Binding SelectedPayment}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource PageTitleTextStyle}"
                                                       Text="Payment details" />
                                            <Button Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Style="{StaticResource CompactToolbarButtonStyle}"
                                                    Command="{Binding DataContext.OpenOrderCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding OrderId}"
                                                    Content="Open order" />
                                        </Grid>
                                        <TextBlock Margin="0,16,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Payment ID" />
                                        <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Text="{Binding Id, Mode=OneWay}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Order ID" />
                                        <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Text="{Binding OrderId, Mode=OneWay}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Customer ID" />
                                        <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Text="{Binding CustomerId, Mode=OneWay}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Status" />
                                        <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Text="{Binding Status, Mode=OneWay}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Amount" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:N2}}" />
                                            <TextBox Margin="4,0,0,0"
                                                     Style="{StaticResource SelectableValueTextBoxStyle}"
                                                     Text="{Binding Currency, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,12,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Payment method" />
                                        <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Text="{Binding PaymentMethod, Mode=OneWay}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Failure reason" />
                                        <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Text="{Binding FailureReason, Mode=OneWay, TargetNullValue=—}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Created UTC" />
                                        <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Text="{Binding CreatedAtUtc, Mode=OneWay}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                   Text="Processed UTC" />
                                        <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                                                 Text="{Binding ProcessedAtUtc, Mode=OneWay, TargetNullValue=—}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
