<UserControl x:Class="Eshop.Operations.Desktop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding LoadOrdersCommand}" Content="Refresh orders" />
            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding LoadOrdersCancelCommand}" Content="Cancel" />
            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding LoadMoreOrdersCommand}" IsEnabled="{Binding CanLoadMore}" Content="Load more" />
            <TextBlock Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Margin="0,0,0,4" Text="Search" />
                <TextBox MinWidth="180" Style="{StaticResource FilterTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search loaded orders by order ID, customer ID, email or status." />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Margin="0,0,0,4" Text="Status" />
                <ComboBox Style="{StaticResource FilterComboBoxStyle}" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Margin="0,0,0,4" Text="Sort" />
                <ComboBox Style="{StaticResource FilterComboBoxStyle}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
            </StackPanel>
            <Button Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ResetViewCommand}" Content="Reset" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding FilterScopeText}" />
            <Border Margin="0,8,0,0" Style="{StaticResource ErrorPanelBorderStyle}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ErrorTitleTextStyle}" Text="Orders request failed" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="Refresh Orders to load operational data." Visibility="{Binding IsInitialState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="No orders were returned." Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="No loaded orders match the current filters." Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <DataGrid x:Name="OrdersDataGrid" ItemsSource="{Binding OrdersView}" Visibility="{Binding HasVisibleOrders, Converter={StaticResource BooleanToVisibilityConverter}}" CurrentCellChanged="OrdersDataGrid_CurrentCellChanged" Style="{StaticResource OperationalDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="*" />
                        <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="75" />
                        <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="65" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerEmail}" Width="2*" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="*" />
                        <DataGridTextColumn Header="Order ID" Binding="{Binding Id}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select an order to view details.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DetailOrderId}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DetailOrderId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource MutedTextStyle}" Text="{Binding DetailStatusText}" TextWrapping="Wrap" />
                        <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource ErrorPanelBorderStyle}" Visibility="{Binding HasDetailError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel><TextBlock Style="{StaticResource ErrorTitleTextStyle}" Text="Order detail request failed" /><TextBlock Margin="0,4,0,0" Text="{Binding DetailErrorMessage}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <ContentControl Grid.Row="2" Margin="0,8,0,0" Content="{Binding SelectedOrderDetail}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Order detail" />
                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            Orientation="Horizontal">
                                                    <Button Style="{StaticResource CompactToolbarButtonStyle}"
                                                            Command="{Binding DataContext.OpenPaymentsForOrderCommand,
                                                                              RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding Id}"
                                                            Content="Payments" />
                                                    <Button Margin="6,0,0,0"
                                                            Style="{StaticResource CompactToolbarButtonStyle}"
                                                            Command="{Binding DataContext.OpenNotificationsForOrderCommand,
                                                                              RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding Id}"
                                                            Content="Notifications" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBox Margin="0,8,0,0" Style="{StaticResource SelectableValueTextBoxStyle}" Text="{Binding Id, Mode=OneWay}" />
                                            <TextBox Margin="0,4,0,0" Style="{StaticResource SelectableValueTextBoxStyle}" Text="{Binding CustomerEmail, Mode=OneWay}" />
                                            <TextBox Margin="0,4,0,0" Style="{StaticResource SelectableValueTextBoxStyle}" Text="{Binding CustomerId, Mode=OneWay}" />
                                            <TextBox Margin="0,4,0,0" Style="{StaticResource SelectableValueTextBoxStyle}" Text="{Binding Status, Mode=OneWay}" />
                                            <TextBox Margin="0,4,0,0" Style="{StaticResource SelectableValueTextBoxStyle}" Text="{Binding PaymentMethod, Mode=OneWay}" />
                                            <TextBox Margin="0,4,0,0" Style="{StaticResource SelectableValueTextBoxStyle}" Text="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N2}}" />
                                            <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Items" />
                                            <DataGrid ItemsSource="{Binding Items}" MinHeight="120" MaxHeight="190" Style="{StaticResource OperationalDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                                                <DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" /><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55" /><DataGridTextColumn Header="Unit" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="*" /><DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="*" /><DataGridTemplateColumn Header="" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Margin="4,2" Style="{StaticResource CompactToolbarButtonStyle}" Command="{Binding DataContext.OpenInventoryForProductCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding ProductId}" Content="Inventory" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Status history" />
                                            <DataGrid ItemsSource="{Binding StatusHistory}" MinHeight="130" MaxHeight="210" Style="{StaticResource OperationalDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                                                <DataGrid.Columns><DataGridTextColumn Header="From" Binding="{Binding FromStatus, TargetNullValue=—}" Width="*" /><DataGridTextColumn Header="To" Binding="{Binding ToStatus}" Width="*" /><DataGridTextColumn Header="Changed UTC" Binding="{Binding ChangedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="*" /><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" /></DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
