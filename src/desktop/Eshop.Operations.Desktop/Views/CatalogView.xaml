<UserControl x:Class="Eshop.Operations.Desktop.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0"
                    Orientation="Horizontal">

			<Button Width="120"
                    Padding="8,4"
                    Command="{Binding LoadProductsCommand}"
                    Content="Refresh catalog" />

			<Button Width="80"
                    Margin="8,0,0,0"
                    Padding="8,4"
                    Command="{Binding LoadProductsCancelCommand}"
                    Content="Cancel" />

			<TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding LoadStatus}" />
		</StackPanel>

		<Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="12"
                BorderBrush="DarkRed"
                BorderThickness="1"
                Visibility="{Binding HasError,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">

			<StackPanel>
				<TextBlock FontWeight="SemiBold"
                           Text="Catalog request failed" />

				<TextBlock Margin="0,4,0,0"
                           Text="{Binding Error.Message}"
                           TextWrapping="Wrap" />

				<StackPanel Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding Error.HasDiagnosticReference,
                                                 Converter={StaticResource BooleanToVisibilityConverter}}">
					<TextBlock Text="Reference: " />
					<TextBlock Text="{Binding Error.DiagnosticReference}" />
				</StackPanel>
			</StackPanel>
		</Border>

		<Grid Grid.Row="2">

			<!-- Initial state -->
			<TextBlock HorizontalAlignment="Center"
					   VerticalAlignment="Center"
					   Text="Catalog has not been loaded."
					   Visibility="{Binding IsInitialState,
                                    Converter={StaticResource BooleanToVisibilityConverter}}" />

			<!-- Empty state -->
			<TextBlock HorizontalAlignment="Center"
					   VerticalAlignment="Center"
					   Text="No Catalog products were returned."
					   Visibility="{Binding IsEmpty,
                                    Converter={StaticResource BooleanToVisibilityConverter}}" />

			<!-- Master-detail content -->
			<Grid Visibility="{Binding HasProducts,
                               Converter={StaticResource BooleanToVisibilityConverter}}">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="3*"
									  MinWidth="420" />

					<ColumnDefinition Width="5" />

					<ColumnDefinition Width="2*"
									  MinWidth="260" />
				</Grid.ColumnDefinitions>

				<!-- Master: product list -->
				<DataGrid Grid.Column="0"
						  ItemsSource="{Binding Products}"
						  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
						  AutoGenerateColumns="False"
						  IsReadOnly="True"
						  CanUserAddRows="False"
						  CanUserDeleteRows="False"
						  CanUserSortColumns="False"
						  SelectionMode="Single"
						  SelectionUnit="FullRow"
						  EnableRowVirtualization="True"
						  EnableColumnVirtualization="True"
						  HeadersVisibility="Column">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Name"
											Binding="{Binding Name}"
											Width="2*" />

						<DataGridTextColumn Header="SKU"
											Binding="{Binding Sku}"
											Width="*" />

						<DataGridTextColumn Header="Category"
											Binding="{Binding Category}"
											Width="*" />

						<DataGridTextColumn Header="Price"
											Binding="{Binding PriceAmount,
                                                      StringFormat=N2}"
											Width="100" />

						<DataGridTextColumn Header="Currency"
											Binding="{Binding Currency}"
											Width="80" />

						<DataGridCheckBoxColumn Header="Active"
												Binding="{Binding IsActive}"
												Width="70" />
					</DataGrid.Columns>
				</DataGrid>

				<!-- Resizable boundary -->
				<GridSplitter Grid.Column="1"
							  Width="5"
							  HorizontalAlignment="Stretch"
							  VerticalAlignment="Stretch"
							  ResizeDirection="Columns"
							  ResizeBehavior="PreviousAndNext" />

				<!-- Detail pane -->
				<Border Grid.Column="2"
						Margin="16,0,0,0"
						Padding="16"
						BorderBrush="Gray"
						BorderThickness="1">

					<Grid>

						<!-- Nothing selected -->
						<TextBlock HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Foreground="Gray"
								   Text="Select a product to view details.">

							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility"
											Value="Collapsed" />

									<Style.Triggers>
										<DataTrigger Binding="{Binding SelectedProduct}"
													 Value="{x:Null}">
											<Setter Property="Visibility"
													Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>

						<!-- Selected product -->
						<ContentControl Content="{Binding SelectedProduct}">

							<ContentControl.Style>
								<Style TargetType="ContentControl">
									<Setter Property="Visibility"
											Value="Visible" />

									<Style.Triggers>
										<DataTrigger Binding="{Binding SelectedProduct}"
													 Value="{x:Null}">
											<Setter Property="Visibility"
													Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ContentControl.Style>

							<ContentControl.ContentTemplate>
								<DataTemplate>
									<ScrollViewer VerticalScrollBarVisibility="Auto">

										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>

											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>

											<!-- Product name -->
											<TextBlock Grid.Row="0"
													   Grid.ColumnSpan="2"
													   Margin="0,0,0,16"
													   FontSize="20"
													   FontWeight="SemiBold"
													   Text="{Binding Name}"
													   TextWrapping="Wrap" />

											<!-- SKU -->
											<TextBlock Grid.Row="1"
													   FontWeight="SemiBold"
													   Text="SKU:" />

											<TextBlock Grid.Row="1"
													   Grid.Column="1"
													   Margin="12,0,0,0"
													   Text="{Binding Sku}" />

											<!-- Category -->
											<TextBlock Grid.Row="2"
													   Margin="0,8,0,0"
													   FontWeight="SemiBold"
													   Text="Category:" />

											<TextBlock Grid.Row="2"
													   Grid.Column="1"
													   Margin="12,8,0,0"
													   Text="{Binding Category}" />

											<!-- Price -->
											<TextBlock Grid.Row="3"
													   Margin="0,8,0,0"
													   FontWeight="SemiBold"
													   Text="Price:" />

											<StackPanel Grid.Row="3"
														Grid.Column="1"
														Margin="12,8,0,0"
														Orientation="Horizontal">

												<TextBlock Text="{Binding PriceAmount,
                                                                 StringFormat=N2}" />

												<TextBlock Margin="4,0,0,0"
														   Text="{Binding Currency}" />
											</StackPanel>

											<!-- Active -->
											<TextBlock Grid.Row="4"
													   Margin="0,8,0,0"
													   FontWeight="SemiBold"
													   Text="Active:" />

											<CheckBox Grid.Row="4"
													  Grid.Column="1"
													  Margin="12,8,0,0"
													  IsChecked="{Binding IsActive}"
													  IsEnabled="False" />

											<!-- Created -->
											<TextBlock Grid.Row="5"
													   Margin="0,8,0,0"
													   FontWeight="SemiBold"
													   Text="Created:" />

											<TextBlock Grid.Row="5"
													   Grid.Column="1"
													   Margin="12,8,0,0"
													   Text="{Binding CreatedAtUtc,
                                                              StringFormat=g}" />

											<!-- Updated -->
											<TextBlock Grid.Row="6"
													   Margin="0,8,0,0"
													   FontWeight="SemiBold"
													   Text="Updated:" />

											<TextBlock Grid.Row="6"
													   Grid.Column="1"
													   Margin="12,8,0,0"
													   Text="{Binding UpdatedAtUtc,
                                                              StringFormat=g,
                                                              TargetNullValue=—}" />

											<!-- Description heading -->
											<TextBlock Grid.Row="7"
													   Grid.ColumnSpan="2"
													   Margin="0,20,0,4"
													   FontWeight="SemiBold"
													   Text="Description" />

											<!-- Description -->
											<TextBlock Grid.Row="8"
													   Grid.ColumnSpan="2"
													   Text="{Binding Description,
                                                              TargetNullValue=—}"
													   TextWrapping="Wrap" />
										</Grid>
									</ScrollViewer>
								</DataTemplate>
							</ContentControl.ContentTemplate>
						</ContentControl>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
