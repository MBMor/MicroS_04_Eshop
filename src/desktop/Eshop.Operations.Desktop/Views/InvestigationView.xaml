<UserControl x:Class="Eshop.Operations.Desktop.Views.InvestigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Investigate" />
            <TextBlock Margin="0,6,0,20"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Open operational data directly from an identifier obtained from a ticket, log entry, or another troubleshooting source."
                       TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Lookup type" />
            <ComboBox Margin="0,6,0,0"
                      MinWidth="280"
                      ItemsSource="{Binding LookupOptions}"
                      SelectedItem="{Binding SelectedLookupOption}"
                      DisplayMemberPath="Title" />

            <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabelTextStyle}" Text="Identifier" />
            <TextBox Margin="0,6,0,0"
                     MinWidth="420"
                     Text="{Binding IdentifierText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="Enter the complete GUID." />

            <Border Margin="0,12,0,0"
                    Style="{StaticResource ErrorPanelBorderStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding DataContext.InspectOperationalIdentifierCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        Content="Inspect" />
                <Button Margin="8,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ResetCommand}"
                        Content="Reset" />
            </StackPanel>

            <Border Margin="0,24,0,0" Style="{StaticResource MutedPanelBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Supported lookups" />
                    <TextBlock Margin="0,8,0,0" Text="Order → exact operational Order detail" />
                    <TextBlock Margin="0,4,0,0" Text="Payments for order → Payments filtered by Order ID" />
                    <TextBlock Margin="0,4,0,0" Text="Inventory for product → Inventory filtered by Product ID" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Trace ID lookup is not available because the current backend does not expose a global trace-query endpoint."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
