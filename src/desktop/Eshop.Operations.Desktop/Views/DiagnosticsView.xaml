<UserControl x:Class="Eshop.Operations.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760"
                    HorizontalAlignment="Left">

			<TextBlock Style="{StaticResource PageTitleTextStyle}"
                        Text="Diagnostics" />

			<TextBlock Margin="0,6,0,24"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Runtime and connection configuration for this Operations Console instance."
                       TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Environment" />

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding EnvironmentName, Mode=OneWay}" />

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="API Gateway" />

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding ApiGatewayBaseAddress, Mode=OneWay}" />

                <TextBlock Grid.Row="2"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="HTTP timeout" />

                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,10,0,0"
                            Orientation="Horizontal">
                    <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                             Text="{Binding ApiGatewayTimeoutSeconds, Mode=OneWay}" />
                    <TextBlock Margin="4,0,0,0"
                               Text="seconds" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Application version" />

                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding ApplicationVersion, Mode=OneWay}" />

                <TextBlock Grid.Row="4"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Build" />

                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding BuildInformation, Mode=OneWay}" />

                <TextBlock Grid.Row="5"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text=".NET runtime" />

                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding RuntimeDescription, Mode=OneWay}" />

                <TextBlock Grid.Row="6"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Operating system" />

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding OperatingSystemDescription, Mode=OneWay}" />

                <TextBlock Grid.Row="7"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Process architecture" />

                <TextBox Grid.Row="7"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding ProcessArchitecture, Mode=OneWay}" />
            </Grid>

            <Border Margin="0,28,0,0"
                    Style="{StaticResource PanelBorderStyle}">

                <StackPanel>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Operational health" />

                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Check API Gateway connectivity to the operational backend services."
                                       TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Orientation="Horizontal">

                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding OperationalHealth.RefreshHealthCommand}"
                                    Content="Refresh health" />

                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding OperationalHealth.RefreshHealthCancelCommand}"
                                    Content="Cancel" />

                        </StackPanel>

                    </Grid>

                    <Grid Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Overall status" />

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Style="{StaticResource SelectableValueTextBoxStyle}"
                                 Text="{Binding OperationalHealth.OverallStatus,
                                                Mode=OneWay}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Checked UTC" />

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,8,0,0"
                                 Style="{StaticResource SelectableValueTextBoxStyle}"
                                 Text="{Binding OperationalHealth.CheckedAtUtc,
                                                Mode=OneWay,
                                                StringFormat={}{0:yyyy-MM-dd HH:mm:ss},
                                                TargetNullValue=—}" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Status" />

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,8,0,0"
                                 Style="{StaticResource SelectableValueTextBoxStyle}"
                                 Text="{Binding OperationalHealth.StatusText,
                                                Mode=OneWay}" />

                    </Grid>

                    <Border Margin="0,12,0,0"
                            Style="{StaticResource ErrorPanelBorderStyle}"
                            Visibility="{Binding OperationalHealth.HasError,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                        <TextBlock Text="{Binding OperationalHealth.ErrorMessage}"
                                   TextWrapping="Wrap" />

                    </Border>

                    <DataGrid Margin="0,16,0,0"
                              MinHeight="180"
                              ItemsSource="{Binding OperationalHealth.Services}"
                              Style="{StaticResource OperationalDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Service"
                                                Binding="{Binding Service}"
                                                Width="2*" />

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="*" />

                            <DataGridTextColumn Header="Duration (ms)"
                                                Binding="{Binding DurationMilliseconds}"
                                                Width="*" />

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

            <Border Margin="0,28,0,0"
                    Style="{StaticResource PanelBorderStyle}">

                <StackPanel>

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Observability" />

                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Use Aspire to inspect distributed traces, service calls, RabbitMQ processing, errors, and business correlation metadata."
                               TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Aspire dashboard" />

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource SelectableValueTextBoxStyle}"
                                 Text="{Binding AspireDashboardUrl,
                                                Mode=OneWay,
                                                TargetNullValue=Not configured}" />

                    </Grid>

                    <StackPanel Margin="0,16,0,0"
                                Orientation="Horizontal">

                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding OpenAspireDashboardCommand}"
                                Content="Open Aspire dashboard" />

                    </StackPanel>

                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap">

                        <Run Text="Useful trace tags: " />

                        <Run FontFamily="Consolas"
                             Text="eshop.order.id" />

                        <Run Text=", " />

                        <Run FontFamily="Consolas"
                             Text="eshop.payment.id" />

                        <Run Text=", " />

                        <Run FontFamily="Consolas"
                             Text="eshop.correlation_id" />

                    </TextBlock>

                </StackPanel>

            </Border>

			<Border Margin="0,28,0,0"
					Style="{StaticResource MutedPanelBorderStyle}">

				<TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="This screen displays local configuration, performs bounded operational health checks through the API Gateway, and provides hand-off to external observability tooling. It does not query telemetry data directly."
						   TextWrapping="Wrap" />

			</Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
