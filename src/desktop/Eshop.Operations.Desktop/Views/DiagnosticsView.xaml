<UserControl x:Class="Eshop.Operations.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760"
                    HorizontalAlignment="Left">

			<TextBlock Style="{StaticResource PageTitleTextStyle}"
                        Text="Diagnostics" />

			<TextBlock Margin="0,6,0,24"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Runtime and connection configuration for this Operations Console instance."
                       TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Environment" />

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding EnvironmentName, Mode=OneWay}" />

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="API Gateway" />

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding ApiGatewayBaseAddress, Mode=OneWay}" />

                <TextBlock Grid.Row="2"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="HTTP timeout" />

                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,10,0,0"
                            Orientation="Horizontal">
                    <TextBox Style="{StaticResource SelectableValueTextBoxStyle}"
                             Text="{Binding ApiGatewayTimeoutSeconds, Mode=OneWay}" />
                    <TextBlock Margin="4,0,0,0"
                               Text="seconds" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Application version" />

                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding ApplicationVersion, Mode=OneWay}" />

                <TextBlock Grid.Row="4"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text=".NET runtime" />

                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding RuntimeDescription, Mode=OneWay}" />

                <TextBlock Grid.Row="5"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Operating system" />

                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding OperatingSystemDescription, Mode=OneWay}" />

                <TextBlock Grid.Row="6"
                           Margin="0,10,0,0"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Text="Process architecture" />

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Style="{StaticResource SelectableValueTextBoxStyle}"
                         Text="{Binding ProcessArchitecture, Mode=OneWay}" />
            </Grid>

			<Border Margin="0,28,0,0"
					Style="{StaticResource MutedPanelBorderStyle}">

				<TextBlock Style="{StaticResource MutedTextStyle}"
						   Text="This screen displays configuration only. It does not perform network health checks."
						   TextWrapping="Wrap" />

			</Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
