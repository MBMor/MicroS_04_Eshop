<Window x:Class="Eshop.Operations.Desktop.Views.InventoryStockAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust inventory stock"
        Width="560"
        SizeToContent="Height"
        MinWidth="520"
        MinHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Adjust inventory stock" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextStyle}" Text="Review the current and projected stock before applying the adjustment." TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" Text="SKU" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" Text="{Binding Item.Sku}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource FieldLabelTextStyle}" Text="Product ID" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,8,0,0" Text="{Binding Item.ProductId}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource FieldLabelTextStyle}" Text="Version" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="16,8,0,0" Text="{Binding Item.Version}" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}"><StackPanel>
                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Current" />
                <TextBlock Margin="0,12,0,0" Text="{Binding Item.OnHandQuantity, StringFormat=On hand: {0}}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Item.ReservedQuantity, StringFormat=Reserved: {0}}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Item.AvailableQuantity, StringFormat=Available: {0}}" />
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}"><StackPanel>
                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Projected" />
                <TextBlock Margin="0,12,0,0" Text="{Binding ProjectedOnHandQuantity, StringFormat=On hand: {0}, TargetNullValue=On hand: —}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Item.ReservedQuantity, StringFormat=Reserved: {0}}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding ProjectedAvailableQuantity, StringFormat=Available: {0}, TargetNullValue=Available: —}" />
            </StackPanel></Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Quantity delta" />
            <TextBox Margin="0,4,0,0" Style="{StaticResource FilterTextBoxStyle}" Text="{Binding QuantityDeltaText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Use a positive number to add stock or a negative number to remove stock." />
            <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabelTextStyle}" Text="Reason" />
            <TextBox Margin="0,4,0,0" Height="80" Padding="6" AcceptsReturn="True" MaxLength="500" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource ErrorTitleTextStyle}" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource MutedPanelBorderStyle}" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap">This operation changes inventory state. The server will verify the current version, stock invariants, authorization, idempotency key, and audit information before committing.</TextBlock>
        </Border>
        <StackPanel Grid.Row="5" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="90" Style="{StaticResource ToolbarButtonStyle}" IsCancel="True" Content="Cancel" />
            <Button MinWidth="130" Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" IsDefault="True" IsEnabled="{Binding CanApply}" Click="ApplyButton_Click" Content="Apply adjustment" />
        </StackPanel>
    </Grid>
</Window>
