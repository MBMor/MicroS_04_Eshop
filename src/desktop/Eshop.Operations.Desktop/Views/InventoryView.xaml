<UserControl x:Class="Eshop.Operations.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">
                <Button Width="120"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding LoadInventoryCommand}"
                        Content="Refresh inventory" />
                <Button Width="80"
                        Margin="8,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding LoadInventoryCancelCommand}"
                        Content="Cancel" />
                <Button Width="110"
                        Margin="8,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding AdjustSelectedStockCommand}"
                        IsEnabled="{Binding CanStartStockAdjustment}"
                        Content="Adjust stock"
                        Visibility="{Binding Authentication.CanAdjustInventory,
                                     Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="{Binding StatusText}" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Text="Search" />
                    <TextBox MinWidth="180"
                             Style="{StaticResource FilterTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">
                    <TextBlock Margin="0,0,0,4"
                               Text="Sort by" />
                    <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>
                <Button Grid.Column="2"
                        MinWidth="80"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ResetViewCommand}"
                        Content="Reset" />
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Style="{StaticResource ErrorPanelBorderStyle}"
                Visibility="{Binding HasError,
                             Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel>
                <TextBlock Style="{StaticResource ErrorTitleTextStyle}"
                           Text="Inventory request failed" />

                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Margin="0,0,0,12"
                    Style="{StaticResource ErrorPanelBorderStyle}"
                    Visibility="{Binding HasAdjustmentError,
                                 Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ErrorTitleTextStyle}"
                               Text="Stock adjustment failed" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding AdjustmentErrorMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,12"
                    Style="{StaticResource ErrorPanelBorderStyle}"
                    Visibility="{Binding HasUnknownAdjustmentOutcome,
                                 Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ErrorTitleTextStyle}"
                               Text="Stock adjustment outcome unknown" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding UnknownOutcomeMessage}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource FieldLabelTextStyle}"
                               Text="Operation ID" />
                    <TextBox Margin="0,4,0,0"
                             IsReadOnly="True"
                             Text="{Binding UnknownOutcomeOperationId,
                                            Mode=OneWay}" />
                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding RetryUnknownStockAdjustmentCommand}"
                                IsEnabled="{Binding CanRetryUnknownStockAdjustment}"
                                Content="Retry same operation" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Do not create a new adjustment while this operation is unresolved." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Refresh Inventory to load operational data."
                       Visibility="{Binding IsInitialState,
                           Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       Text="No inventory items were returned."
                       Visibility="{Binding IsEmpty,
                           Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       Text="No inventory items match the current search."
                       Visibility="{Binding IsFilteredEmpty,
                           Converter={StaticResource BooleanToVisibilityConverter}}" />

            <DataGrid ItemsSource="{Binding ItemsView}"
                      Visibility="{Binding HasVisibleItems,
                          Converter={StaticResource BooleanToVisibilityConverter}}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      Style="{StaticResource OperationalDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="SKU"
                                        Binding="{Binding Sku}"
                                        Width="2*" />

                    <DataGridTextColumn Header="On hand"
                                        Binding="{Binding OnHandQuantity}"
                                        Width="*" />

                    <DataGridTextColumn Header="Reserved"
                                        Binding="{Binding ReservedQuantity}"
                                        Width="*" />

                    <DataGridTextColumn Header="Available"
                                        Binding="{Binding AvailableQuantity}"
                                        Width="*" />

                    <DataGridCheckBoxColumn Header="Active"
                                            Binding="{Binding IsActive}"
                                            Width="80" />

                    <DataGridTextColumn Header="Product ID"
                                        Binding="{Binding ProductId}"
                                        Width="2*" />

                </DataGrid.Columns>
            </DataGrid>

        </Grid>

    </Grid>
</UserControl>
