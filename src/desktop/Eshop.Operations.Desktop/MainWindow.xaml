<Window x:Class="Eshop.Operations.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Eshop.Operations.Desktop.ViewModels"
        xmlns:views="clr-namespace:Eshop.Operations.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:ShellViewModel,
                                        IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:CatalogViewModel}">
            <views:CatalogView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
           Style="{StaticResource ApplicationTitleTextStyle}"
           Text="{Binding ApplicationTitle}" />

        <StackPanel Grid.Row="1"
                    Margin="0,8,0,24"
                    Orientation="Horizontal">

            <TextBlock FontWeight="SemiBold"
                       Text="Environment: " />

            <TextBlock Text="{Binding EnvironmentName}" />

            <TextBlock Margin="24,0,0,0"
                       FontWeight="SemiBold"
                       Text="Section: " />

            <TextBlock Text="{Binding CurrentSectionTitle}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="Navigation" />

                <ToggleButton Style="{StaticResource NavigationToggleButtonStyle}"
                  IsChecked="{Binding IsCatalogActive, Mode=OneWay}"
                  Command="{Binding ShowCatalogCommand}"
                  Content="Catalog" />

                    <ToggleButton Margin="0,8,0,0"
                  Style="{StaticResource NavigationToggleButtonStyle}"
                  IsChecked="{Binding IsDiagnosticsActive, Mode=OneWay}"
                  Command="{Binding ShowDiagnosticsCommand}"
                  Content="Diagnostics" />
            </StackPanel>

            <Border Grid.Column="2"
                Style="{StaticResource PanelBorderStyle}">

                <ContentControl Content="{Binding CurrentViewModel}" />

            </Border>
        </Grid>

        <Border Grid.Row="3"
        Margin="0,20,0,0"
        Padding="10,6"
        Background="{StaticResource SurfaceMutedBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1">

            <StackPanel Orientation="Horizontal">

                <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                   Text="Status: " />

                <TextBlock Style="{StaticResource MutedTextStyle}"
                   Text="{Binding StatusText}" />

            </StackPanel>

        </Border>
    </Grid>
</Window>
