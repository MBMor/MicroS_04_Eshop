<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush"
                     Color="#F5F7FA" />

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="#FFFFFF" />

    <SolidColorBrush x:Key="SurfaceMutedBrush"
                     Color="#F3F4F6" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"
                     Color="#1F2937" />

    <SolidColorBrush x:Key="TextSecondaryBrush"
                     Color="#6B7280" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#D1D5DB" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#2563EB" />

    <SolidColorBrush x:Key="AccentMutedBrush"
                     Color="#EFF6FF" />

    <!-- Error -->
    <SolidColorBrush x:Key="ErrorBackgroundBrush"
                     Color="#FEF2F2" />

    <SolidColorBrush x:Key="ErrorBorderBrush"
                     Color="#DC2626" />

    <SolidColorBrush x:Key="ErrorTextBrush"
                     Color="#991B1B" />

    <!-- Semantic spacing -->
    <Thickness x:Key="PageMargin">24</Thickness>

    <Thickness x:Key="PanelPadding">16</Thickness>

    <Thickness x:Key="ControlPadding">10,6</Thickness>

    <Thickness x:Key="CompactControlPadding">8,4</Thickness>

</ResourceDictionary>
