<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography -->

    <Style x:Key="PageTitleTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="22" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ApplicationTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PageTitleTextStyle}">
        <Setter Property="FontSize"
                Value="24" />
    </Style>

    <Style x:Key="MutedTextStyle"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="FieldLabelTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ErrorTitleTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource ErrorTextBrush}" />
    </Style>

    <!-- Buttons -->

    <Style x:Key="BaseButtonStyle"
           TargetType="Button">
        <Setter Property="Padding"
                Value="{StaticResource ControlPadding}" />
        <Setter Property="MinHeight"
                Value="32" />
    </Style>

    <Style x:Key="ToolbarButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="MinWidth"
                Value="88" />
    </Style>

    <Style x:Key="CompactToolbarButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="MinWidth"
                Value="72" />
        <Setter Property="MinHeight"
                Value="28" />
        <Setter Property="Padding"
                Value="{StaticResource CompactControlPadding}" />
    </Style>

    <!-- Navigation -->

    <Style x:Key="NavigationToggleButtonStyle"
           TargetType="ToggleButton">
        <Setter Property="MinHeight"
                Value="32" />
        <Setter Property="Padding"
                Value="8,4" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="1" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="{StaticResource SurfaceMutedBrush}" />
            </Trigger>

            <Trigger Property="IsChecked"
                     Value="True">
                <Setter Property="Background"
                        Value="{StaticResource AccentMutedBrush}" />
                <Setter Property="Foreground"
                        Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource AccentBrush}" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Input controls -->

    <Style x:Key="FilterTextBoxStyle"
           TargetType="TextBox">
        <Setter Property="MinHeight"
                Value="30" />
        <Setter Property="Padding"
                Value="6,4" />
    </Style>

    <Style x:Key="FilterComboBoxStyle"
       TargetType="ComboBox">
        <Setter Property="MinHeight"
            Value="30" />

        <Setter Property="VerticalContentAlignment"
            Value="Center" />

        <Setter Property="HorizontalContentAlignment"
            Value="Left" />
    </Style>

    <!-- Panels -->

    <Style x:Key="PanelBorderStyle"
           TargetType="Border">
        <Setter Property="Padding"
                Value="{StaticResource PanelPadding}" />
        <Setter Property="Background"
                Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
    </Style>

    <Style x:Key="MutedPanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource PanelBorderStyle}">
        <Setter Property="Background"
                Value="{StaticResource SurfaceMutedBrush}" />
    </Style>

    <Style x:Key="ErrorPanelBorderStyle"
           TargetType="Border">
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="Background"
                Value="{StaticResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource ErrorBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
    </Style>

    <!-- DataGrid visual baseline -->

    <Style x:Key="OperationalDataGridStyle"
           TargetType="DataGrid">
        <Setter Property="Background"
                Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="RowBackground"
                Value="{StaticResource SurfaceBrush}" />
        <Setter Property="AlternatingRowBackground"
                Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="AlternationCount"
                Value="2" />
    </Style>

</ResourceDictionary>
